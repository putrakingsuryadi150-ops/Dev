task.spawn(function()
	while loadingRoot.Parent and backgroundAnimAlive do

		for _, dot in ipairs(particles) do
			if dot.Parent then
				local oldPos = dot.Position

				TweenService:Create(dot, TweenInfo.new(
					math.random(25, 50) / 10,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				), {
					Position = UDim2.fromScale(
						math.clamp(oldPos.X.Scale + math.random(-80, 80) / 1000, 0, 1),
						math.clamp(oldPos.Y.Scale + math.random(-80, 80) / 1000, 0, 1)
					),
					BackgroundTransparency = math.random(20, 80) / 100
				}):Play()
			end
		end

		task.wait(2)
	end
end)

