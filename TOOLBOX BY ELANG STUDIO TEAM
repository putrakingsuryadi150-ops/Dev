local function typeWriter(label, speed)
	label.TextTransparency = 0
	local original = label.Text
	label.Text = ""

	for i = 1, #original do
		if not label.Parent then return end
		label.Text = string.sub(original, 1, i)
		label.Position = UDim2.fromScale(0.5, label == title and 0.38 or 0.61)
		task.wait(speed)
	end

	label.Text = original
end

