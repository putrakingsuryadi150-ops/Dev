
-- FLY GUI V4
-- Single LocalScript
-- Letakkan di StarterPlayerScripts

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local flying = false
local speed = 50
local up = false
local down = false
local minimized = false

local velocity
local gyro
local flyConnection

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "FlyGuiV3"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 385, 0, 178)
frame.Position = UDim2.new(0, 10, 0.35, 0)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
frame.BorderColor3 = Color3.new(0, 0, 0)
frame.BorderSizePixel = 2
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local function makeButton(name, text, pos, size, color)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Text = text
    button.Position = pos
    button.Size = size
    button.BackgroundColor3 = color
    button.TextColor3 = Color3.new(0, 0, 0)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 2
    button.Parent = frame
    return button
end

-- Warna
local red = Color3.fromRGB(235, 35, 10)
local purple = Color3.fromRGB(185, 140, 225)
local green = Color3.fromRGB(60, 255, 145)
local blue = Color3.fromRGB(115, 130, 255)
local cyan = Color3.fromRGB(100, 255, 245)
local lime = Color3.fromRGB(205, 255, 110)
local orange = Color3.fromRGB(255, 80, 0)
local yellow = Color3.fromRGB(255, 245, 65)

-- Baris atas
local close = makeButton(
    "Close", "X",
    UDim2.new(0, 0, 0, 0),
    UDim2.new(0, 88, 0, 58), red
)

local minimize = makeButton(
    "Minimize", "-",
    UDim2.new(0, 88, 0, 0),
    UDim2.new(0, 92, 0, 58), purple
)

-- Baris tengah
local upButton = makeButton(
    "Up", "UP",
    UDim2.new(0, 0, 0, 60),
    UDim2.new(0, 88, 0, 57), green
)

local plus = makeButton(
    "Plus", "+",
    UDim2.new(0, 88, 0, 60),
    UDim2.new(0, 92, 0, 57), blue
)

local title = makeButton(
    "Title", "FLY GUI V4 by DEV STUDIO",
    UDim2.new(0, 180, 0, 60),
    UDim2.new(0, 200, 0, 57),
    Color3.fromRGB(230, 40, 240)
)

-- Baris bawah
local downButton = makeButton(
    "Down", "DOWN",
    UDim2.new(0, 0, 0, 118),
    UDim2.new(0, 88, 0, 58), lime
)

local minus = makeButton(
    "Minus", "-",
    UDim2.new(0, 88, 0, 118),
    UDim2.new(0, 92, 0, 58), cyan
)

local speedLabel = makeButton(
    "Speed", "1",
    UDim2.new(0, 180, 0, 118),
    UDim2.new(0, 90, 0, 58), orange
)

local flyButton = makeButton(
    "Fly", "fly",
    UDim2.new(0, 270, 0, 118),
    UDim2.new(0, 110, 0, 58), yellow
)

-- Mendapatkan karakter
local function getCharacter()
    local character = player.Character
        or player.CharacterAdded:Wait()

    local humanoid = character:WaitForChild("Humanoid")
    local root = character:WaitForChild("HumanoidRootPart")

    return character, humanoid, root
end

-- Update kecepatan
local function updateSpeed()
    speedLabel.Text = tostring(speed)
end

-- Mematikan Fly
local function stopFly()
    flying = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if velocity then
        velocity:Destroy()
        velocity = nil
    end

    if gyro then
        gyro:Destroy()
        gyro = nil
    end

    flyButton.Text = "fly"
    flyButton.BackgroundColor3 = yellow
end

-- Mengaktifkan Fly
local function startFly()
    local character, humanoid, root = getCharacter()

    if flying then return end

    flying = true

    velocity = Instance.new("BodyVelocity")
    velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    velocity.Velocity = Vector3.zero
    velocity.Parent = root

    gyro = Instance.new("BodyGyro")
    gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    gyro.P = 10000
    gyro.CFrame = camera.CFrame
    gyro.Parent = root

    flyButton.Text = "ON"
    flyButton.BackgroundColor3 = Color3.fromRGB(50, 255, 50)

    flyConnection = RunService.RenderStepped:Connect(function()
        if not flying or not root.Parent then
            stopFly()
            return
        end

        local move = Vector3.zero

        local cameraCF = camera.CFrame

        local forward = cameraCF.LookVector
        local right = cameraCF.RightVector

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            move += forward
        end

        if UIS:IsKeyDown(Enum.KeyCode.S) then
            move -= forward
        end

        if UIS:IsKeyDown(Enum.KeyCode.D) then
            move += right
        end

        if UIS:IsKeyDown(Enum.KeyCode.A) then
            move -= right
        end

        if UIS:IsKeyDown(Enum.KeyCode.Space) or up then
            move += Vector3.new(0, 1, 0)
        end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or down then
            move -= Vector3.new(0, 1, 0)
        end

        if move.Magnitude > 0 then
            move = move.Unit * speed
        end

        velocity.Velocity = move
        gyro.CFrame = cameraCF
    end)
end

-- Tombol Fly
flyButton.MouseButton1Click:Connect(function()
    if flying then
        stopFly()
    else
        startFly()
    end
end)

-- Tambah kecepatan
plus.MouseButton1Click:Connect(function()
    speed = math.min(speed + 10, 500)
    updateSpeed()
end)

-- Kurangi kecepatan
minus.MouseButton1Click:Connect(function()
    speed = math.max(speed - 10, 10)
    updateSpeed()
end)

-- Tombol UP
upButton.MouseButton1Down:Connect(function()
    up = true
end)

upButton.MouseButton1Up:Connect(function()
    up = false
end)

upButton.MouseLeave:Connect(function()
    up = false
end)

-- Tombol DOWN
downButton.MouseButton1Down:Connect(function()
    down = true
end)

downButton.MouseButton1Up:Connect(function()
    down = false
end)

downButton.MouseLeave:Connect(function()
    down = false
end)

-- Minimize GUI
minimize.MouseButton1Click:Connect(function()
    minimized = not minimized

    for _, object in ipairs(frame:GetChildren()) do
        if object ~= close and object ~= minimize then
            object.Visible = not minimized
        end
    end

    frame.Size = minimized
        and UDim2.new(0, 180, 0, 58)
        or UDim2.new(0, 385, 0, 178)

    minimize.Text = minimized and "+" or "-"
end)

-- Tutup GUI
close.MouseButton1Click:Connect(function()
    stopFly()
    gui:Destroy()
end)

-- Keyboard F untuk Fly ON/OFF
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.F then
        if flying then
            stopFly()
        else
            startFly()
        end
    end
end)

-- Reset ketika karakter respawn
player.CharacterAdded:Connect(function()
    stopFly()
    up = false
    down = false
end)

updateSpeed()

print("FLY GUI V4 by DEV STUDIO COMMUNITY berhasil dijalankan!")
